{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "longDescription": "Lantenna scans the local network and lists the hosts it\nfinds, with their host names, MAC vendors, inferred device types and open\nports, in a Mac OS 8 interface.",
    "linux": {
      "deb": {
        "depends": ["iputils-ping", "iproute2"],
        "section": "net",
        "files": {
          "/usr/share/doc/lantenna/copyright": "licenses/copyright",
          "/usr/share/doc/lantenna/Third-Party-Notices.txt": "../build/Third-Party-Notices.txt",
          "/usr/share/doc/lantenna/Rust-Licenses.html": "licenses/Rust-Licenses.html"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/lantenna/copyright": "licenses/copyright",
          "/usr/share/doc/lantenna/Third-Party-Notices.txt": "../build/Third-Party-Notices.txt",
          "/usr/share/doc/lantenna/Rust-Licenses.html": "licenses/Rust-Licenses.html"
        }
      }
    }
  }
}
